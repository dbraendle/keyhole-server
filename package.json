{
  "name": "keyhole-server",
  "version": "0.5.0",
  "description": "Minimal private file store for the Keyhole Obsidian plugin.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Dennis Brändle",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "start": "node src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
